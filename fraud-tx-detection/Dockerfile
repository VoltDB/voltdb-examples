# ============================================================================
# VoltDB fraud-tx-detection Example - Docker Image
# ============================================================================
# Auto-generated by generate-dockerfiles.sh - DO NOT EDIT MANUALLY
# To customize, edit the generator script and run with --force
#
# Build from repo root:
#   docker build -t voltdb-example-fraud-tx-detection -f fraud-tx-detection/Dockerfile .
# ============================================================================

ARG VOLTDB_IMAGE=voltactivedata/volt-developer-edition:15.2.0_voltdb

# ----------------------------------------------------------------------------
# Stage 1: Build with Maven
# ----------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21-alpine AS builder
ENV MAVEN_OPTS="-Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn"
WORKDIR /build

# Copy entire project (needed for parent POM resolution via relativePath)
# Note: fraud-tx-detection is not a module in the parent reactor, but its pom
# inherits from /build/pom.xml via parent.relativePath. Build with -f directly.
COPY . .

# Build and copy dependencies
RUN mvn -f fraud-tx-detection/pom.xml package -DskipTests && \
    mkdir -p /build/fraud-tx-detection/target/dependency && \
    mvn -f fraud-tx-detection/pom.xml dependency:copy-dependencies \
        -DoutputDirectory=/build/fraud-tx-detection/target/dependency \
        -DincludeScope=runtime

# ----------------------------------------------------------------------------
# Stage 2: VoltDB source (for sqlcmd and tools)
# ----------------------------------------------------------------------------
FROM ${VOLTDB_IMAGE} AS voltdb-source

# ----------------------------------------------------------------------------
# Stage 3: Runtime Image
# ----------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi10-minimal:latest

# Install runtime packages (minimal set for entrypoint.sh)
RUN microdnf install --assumeyes --best --nodocs \
      java-21-openjdk-headless \
      nc \
      shadow-utils \
      tar \
      which && \
    microdnf clean all

ENV JAVA_HOME=/usr/lib/jvm/jre-21-openjdk

# Copy VoltDB installation for sqlcmd and tools
COPY --from=voltdb-source /opt/voltdb /opt/voltdb

ENV VOLTDB_HOME=/opt/voltdb
ENV PATH="${VOLTDB_HOME}/bin:${JAVA_HOME}/bin:${PATH}"

WORKDIR /app

# Create non-root user
RUN groupadd -g 10000 voltapp && useradd -u 10000 -g voltapp -m voltapp

# Copy artifacts from builder
COPY --from=builder /build/fraud-tx-detection/target/fraud-tx-detection-*.jar /app/app.jar
COPY --from=builder /build/fraud-tx-detection/target/dependency/ /app/lib/
COPY --from=builder /build/fraud-tx-detection/src/main/resources/ddl.sql /app/ddl.sql
COPY docker/scripts/entrypoint.sh /app/entrypoint.sh

# Rename for consistency
RUN mv /app/app.jar /app/client.jar && \
    cp /app/client.jar /app/procs.jar && \
    chmod +x /app/entrypoint.sh && \
    chown -R voltapp:voltapp /app

ENV APP_NAME=fraud-tx-detection
ENV MAIN_CLASS=com.example.voltdb.FraudDetectionApp
ENV DDL_FILE=/app/ddl.sql
ENV PROCS_JAR=/app/procs.jar
ENV CLIENT_JAR=/app/client.jar
ENV VOLTDB_SERVERS=localhost:21212
ENV DURATION=120
ENV WARMUP=5
ENV DISPLAY_INTERVAL=5
ENV MODE=init-run
# This app uses positional arguments: host port targetTPS duration
ENV ARG_STYLE=positional
ENV TARGET_TPS=1000

USER voltapp
ENTRYPOINT ["/app/entrypoint.sh"]
