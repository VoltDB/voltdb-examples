# Env vars sourced by RUNBOOK.md commands.
# Copy to runbook.env (gitignored), edit the values, then: source runbook.env

# GCP project that owns PubSub + BigQuery + Dataflow + GKE for the demo.
export PROJECT=your-gcp-project

# Region for Dataflow + GCS bucket + BigQuery dataset + BigQuery connection.
# All four MUST match: BigQuery managed Iceberg tables require the bucket,
# dataset, and connection to live in the same single region (not a multi-region).
export REGION=us-central1

# GCS bucket for Dataflow staging + the Iceberg-backed page_hits_raw table +
# the MaxMind GeoLite2-City .mmdb asset. Must be in $REGION.
export BUCKET=your-dataflow-bucket

# Kubernetes namespace holding the VoltDB cluster.
export NS=beam-threat-detection

# Helm release name for the voltdb-operator chart install. The chart derives
# service names from this prefix (e.g. ${REL}-voltdb-cluster-client).
export REL=beam-threat

# kubectl context pointing at the GKE cluster that will host VoltDB.
# Typical form: gke_<project>_<zone>_<cluster-name>
export CTX=gke_${PROJECT}_${REGION}-a_your-gke-cluster

# Path to the VoltDB enterprise license XML.
export LIC=~/voltdb-license.xml

# Local checkout of the voltdb-operator Helm chart.
export CHART=~/voltdb-operator/charts/voltdb-operator
