# ============================================================================
# VoltDB metrocard Example - Docker Image
# ============================================================================
# Auto-generated by generate-dockerfiles.sh - DO NOT EDIT MANUALLY
# To customize, edit the generator script and run with --force
#
# Build from repo root:
#   docker build -t voltdb-example-metrocard -f metrocard/Dockerfile .
# ============================================================================

ARG VOLTDB_IMAGE=voltactivedata/volt-developer-edition:15.2.0_voltdb

# ----------------------------------------------------------------------------
# Stage 1: Build with Maven
# ----------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21-alpine AS builder
ENV MAVEN_OPTS="-Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn"
WORKDIR /build

# Copy entire project (needed for parent POM resolution via relativePath)
# Note: metrocard is not a module in the parent reactor, but its pom inherits
# from /build/pom.xml via parent.relativePath. Build with -f directly.
COPY . .

# Build and copy dependencies
RUN mvn -f metrocard/pom.xml package -DskipTests && \
    mkdir -p /build/metrocard/target/dependency && \
    mvn -f metrocard/pom.xml dependency:copy-dependencies \
        -DoutputDirectory=/build/metrocard/target/dependency \
        -DincludeScope=runtime

# ----------------------------------------------------------------------------
# Stage 2: VoltDB source (for sqlcmd and tools)
# ----------------------------------------------------------------------------
FROM ${VOLTDB_IMAGE} AS voltdb-source

# ----------------------------------------------------------------------------
# Stage 3: Runtime Image
# ----------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi10-minimal:latest

# Install runtime packages (minimal set for entrypoint.sh)
RUN microdnf install --assumeyes --best --nodocs \
      java-21-openjdk-headless \
      nc \
      shadow-utils \
      tar \
      which && \
    microdnf clean all

ENV JAVA_HOME=/usr/lib/jvm/jre-21-openjdk

# Copy VoltDB installation for sqlcmd and tools
COPY --from=voltdb-source /opt/voltdb /opt/voltdb

ENV VOLTDB_HOME=/opt/voltdb
ENV PATH="${VOLTDB_HOME}/bin:${JAVA_HOME}/bin:${PATH}"

WORKDIR /app

# Create non-root user
RUN groupadd -g 10000 voltapp && useradd -u 10000 -g voltapp -m voltapp

# Copy artifacts from builder
COPY --from=builder /build/metrocard/target/metrocard-1.0-SNAPSHOT.jar /app/procs.jar
COPY --from=builder /build/metrocard/target/metrocard-1.0-SNAPSHOT.jar /app/client.jar
COPY --from=builder /build/metrocard/target/dependency/ /app/lib/
COPY --from=builder /build/metrocard/ddl.sql /app/ddl.sql

# Copy data directory
COPY --from=builder /build/metrocard/data/ /app/data/

COPY docker/scripts/entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh && chown -R voltapp:voltapp /app

ENV APP_NAME=metrocard
ENV MAIN_CLASS=metrocard.MetroBenchmark
ENV DDL_FILE=/app/ddl.sql
ENV PROCS_JAR=/app/procs.jar
ENV CLIENT_JAR=/app/client.jar
ENV VOLTDB_SERVERS=localhost:21212
ENV DURATION=120
ENV WARMUP=5
ENV DISPLAY_INTERVAL=5
ENV MODE=init-run
# Load station data after DDL
ENV CSV_LOADS="mc_stations:data/stations.csv"

USER voltapp
ENTRYPOINT ["/app/entrypoint.sh"]
